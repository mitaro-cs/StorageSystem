{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "groupbase",
	"version": "0.1.0",
	"identifier": "app.groupbase",
	"build": {
		"frontendDist": "../ui"
	},
	"app": {
		"withGlobalTauri": true,
		"windows": [],
		"security": {
			"csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
		}
	},
	"bundle": {
		"active": true,
		"targets": "all",
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.icns",
			"icons/icon.ico",
			"icons/Assets.car"
		],
		"resources": {
			"resources/runtime/": "runtime/",
			"resources/groupbase.jar": "groupbase.jar"
		},
		"category": "Education",
		"shortDescription": "Сайт студенческой группы на своём компьютере",
		"longDescription": "groupbase: новости, домашние задания и материалы группы. Сервер работает на компьютере старосты или хоста, одногруппники заходят по ссылке с телефона и видят всё даже без связи.",
		"copyright": "groupbase, GNU AGPL-3.0",
		"macOS": {
			"signingIdentity": "-",
			"minimumSystemVersion": "11.0"
		},
		"windows": {
			"webviewInstallMode": {
				"type": "downloadBootstrapper"
			},
			"nsis": {
				"installMode": "currentUser",
				"languages": [
					"Russian"
				],
				"displayLanguageSelector": false
			}
		},
		"createUpdaterArtifacts": true
	},
	"plugins": {
		"updater": {
			"pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDZDQzE3MkFEMzMwRkRBQjQKUldTMDJnOHpyWExCYkhTdmJjajNmZDdENi80TGYxZFQ2ajlQNU96cUo2S1hnSXllTzdkUFpHU3cK",
			"endpoints": [
				"https://github.com/mitaro-cs/StorageSystem/releases/latest/download/latest.json"
			],
			"windows": {
				"installMode": "passive"
			}
		}
	}
}
